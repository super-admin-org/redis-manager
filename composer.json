{
    "name": "super-admin-org/redis-manager",
    "description": "Redis manager for super-admin",
    "type": "library",
    "keywords": [
        "super-admin",
        "redis",
        "manager"
    ],
    "homepage": "https://github.com/super-admin-org/redis-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "sb | super-admin",
            "email": "info@super-admin.org"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "super-admin-org/super-admin": "^1.0",
        "predis/predis": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SuperAdmin\\Admin\\RedisManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperAdmin\\Admin\\RedisManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SuperAdmin\\Admin\\RedisManager\\RedisManagerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
